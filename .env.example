# MongoDB (required for admin users and content)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# Auth (required for admin dashboard)
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# S3 bucket – image uploads (admin news, gallery, divisions)
# Required: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, S3_BUCKET
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name

# Optional: custom S3-compatible endpoint (e.g. MinIO)
# S3_URL=https://minio.example.com

# Optional: public URL for uploaded images (e.g. CloudFront or bucket URL)
# S3_PUBLIC_BASE_URL=https://your-bucket.s3.us-east-1.amazonaws.com

# Optional: hostname for next/image optimization (set in Vercel for S3 images)
# S3_IMAGE_HOSTNAME=your-bucket.s3.us-east-1.amazonaws.com
